---====== Load spawner ======---
local spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"))()

---====== Wait for game data ======---
local replicatedStorage = game:GetService("ReplicatedStorage")
repeat task.wait() until replicatedStorage:FindFirstChild("GameData") and replicatedStorage.GameData:FindFirstChild("LatestRoom")
local latestRoom = replicatedStorage.GameData.LatestRoom

---====== Create entity template with Jumpscare ======---
local entity = spawner.Create({
    Entity = {
        Name = "Nightmare Ambush",
        Asset = "rbxassetid://10826375579",
        HeightOffset = 1
    },
    Lights = {
        Flicker = { Enabled = true, Duration = 5 },
        Shatter = true,
        Repair = false
    },
    Earthquake = { Enabled = true },
    CameraShake = { Enabled = true, Range = 100, Values = {12, 30, 0.4, 1.5} },
    Movement = { Speed = 700, Delay = 1, Reversed = true },
    Rebounding = { Enabled = true, Type = "Ambush", Min = 4, Max = 6, Delay = 0.8 },
    Damage = { Enabled = true, IgnoreHiding = false, Range = 100, Amount = 100 },
    
    ---====== Jumpscare Configuration ======---
    Jumpscare = {
        Enabled = true,
        Image = "rbxassetid://10826375579", -- The image asset ID shown on screen during the jumpscare
        Sound = "rbxassetid://104513172698892", -- The audio asset ID played during the jumpscare
        Duration = 2, -- How long in seconds the jumpscare lasts before showing the death screen
        Color = Color3.fromRGB(255, 0, 0) -- Optional tint color for the jumpscare
    },
    
    Crucifixion = { Enabled = true, Range = 40, Resist = false, Break = true },
    Death = {
        Type = "Guiding",
        Hints = {"You died to Nightmare Ambush.", "Watch out for the jumpscare!"},
        Cause = "Nightmare Ambush"
    }
})

---====== Debug Callbacks ======---
entity:SetCallback("OnSpawned", function()
    print("Nightmare Ambush has spawned")
end)

entity:SetCallback("OnStartMoving", function()
    print("Nightmare Ambush has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
    if firstTime == true then
        print("Nightmare Ambush has entered room: ".. room.Name.. " for the first time")
    else
        print("Nightmare Ambush has entered room: ".. room.Name.. " again")
    end
end)

entity:SetCallback("OnDespawned", function()
    print("Nightmare Ambush despawned")
end)

---====== Synced Room Progression Loop ======---
local SpawnChance = 15
local MinRoom = 20
local lastRoomVal = latestRoom.Value

latestRoom.Changed:Connect(function(roomNum)
    if roomNum > lastRoomVal then
        lastRoomVal = roomNum
        math.randomseed(roomNum * 12345)
        
        if roomNum >= MinRoom then
            local roll = math.random(1, 100)
            if roll <= SpawnChance then
                pcall(function()
                    entity:Run()
                end)
            end
        end
    end
end)
