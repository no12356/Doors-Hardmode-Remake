---====== Load spawner ======---
local spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"))()

---====== Create entity template ======---
local entity = spawner.Create({
    Entity = {
        Name = "200",
        Asset = "https://raw.githubusercontent.com/Isth4t/DoorsModels/main/200Moving.rbxm", -- Replace with your uploaded model asset ID if needed
        HeightOffset = 0
    },
    Lights = {
        Flicker = { Enabled = true, Duration = 3 },
        Shatter = true,
        Repair = false
    },
    Earthquake = { Enabled = true },
    CameraShake = { Enabled = true, Range = 120, Values = {5, 15, 0.1, 1} },
    Movement = { Speed = 500, Delay = 10, Reversed = false },
    Rebounding = { Enabled = true, Type = "Ambush", Min = 4, Max = 4, Delay = 2 },
    Damage = { Enabled = true, IgnoreHiding = false, Range = 90, Amount = 100 },
    Crucifixion = { Enabled = true, Range = 40, Resist = false, Break = true },
    Death = {
        Type = "Guiding",
        Hints = {"You died to 200.", "It's very fast.", "Hide when you hear it!", "Its like A-60 but with less rebounds"},
        Cause = "200"
    }
})

---====== Debug Callbacks ======---
entity:SetCallback("OnSpawned", function()
    print("200 has spawned")
end)

entity:SetCallback("OnStartMoving", function()
    print("200 has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
    if firstTime == true then
        print("200 has entered room: ".. room.Name.. " for the first time")
    else
        print("200 has entered room: ".. room.Name.. " again")
    end
end)

entity:SetCallback("OnDespawned", function()
    print("200 despawned")
end)

---====== Run entity ======---
entity:Run()
