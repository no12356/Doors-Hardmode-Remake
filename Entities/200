---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
	print("200 has spawned")
end)

entity:SetCallback("OnStartMoving", function()
	print("200 has started moving")
end)

entity:SetCallback("OnReachNode", function(node)
	print("200 has reached node:", node)
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
	if firstTime == true then
		print("200 has entered room: ".. room.Name.. " for the first time")
	else
		print("200 has entered room: ".. room.Name.. " again")
	end
end)

entity:SetCallback("OnLookAt", function(lineOfSight)
	if lineOfSight == true then
		print("Player is looking at 200")
	else
		print("Player view is obstructed from 200")
	end
end)

entity:SetCallback("OnRebounding", function(startOfRebound)
	if startOfRebound == true then
		print("200 has started rebounding")
	else
		print("200 has finished rebounding")
	end
end)

entity:SetCallback("OnDespawning", function()
	print("200 is despawning")
end)

entity:SetCallback("OnDespawned", function()
	print("200 has despawned")
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
	if newHealth == 0 then
		print("200 has killed the player")
	else
		print("200 has damaged the player")
	end
end)

---====== Run entity ======---

entity:Run()

