---====== Load spawner ======---
local spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"))()

---====== Create entity template ======---
local entity = spawner.Create({
    Entity = {
        Name = "VHS!Sans",
        Asset = "rbxassetid://18454349540",
        HeightOffset = 1
    },
    Lights = {
        Flicker = { Enabled = true, Duration = 5 },
        Shatter = true,
        Repair = false
    },
    Earthquake = { Enabled = true },
    CameraShake = { Enabled = true, Range = 100, Values = {10, 20, 0.2, 1.5} },
    Movement = { Speed = 21, Delay = 3, Reversed = false },
    Rebounding = { Enabled = true, Type = "Ambush", Min = 1, Max = 1, Delay = 3 },
    Damage = { Enabled = true, IgnoreHiding = false, Range = 100, Amount = 199 },
    Crucifixion = { Enabled = true, Range = 40, Resist = false, Break = true },
    Death = {
        Type = "Curious",
        Hints = {"You died to who you call vhs!sans...", "Try your best to out-run him.", "I really don't have nothing else", "Just try your best to run and Hide when you can."},
        Cause = "VHS!Sans"
    }
})

---====== Debug Callbacks ======---
entity:SetCallback("OnSpawned", function()
    print("VHS!Sans has spawned")
end)

entity:SetCallback("OnStartMoving", function()
    print("VHS!Sans has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
    if firstTime == true then
        print("VHS!Sans has entered room: ".. room.Name.. " for the first time")
    else
        print("VHS!Sans has entered room: ".. room.Name.. " again")
    end
end)

entity:SetCallback("OnDespawned", function()
    print("VHS!Sans despawned")
end)

---====== Run entity ======---
entity:Run()
