---====== Load spawner ======---
local spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"))()

---====== Wait for game data ======---
local replicatedStorage = game:GetService("ReplicatedStorage")
repeat task.wait() until replicatedStorage:FindFirstChild("GameData") and replicatedStorage.GameData:FindFirstChild("LatestRoom")
local latestRoom = replicatedStorage.GameData.LatestRoom

---====== Create entity template ======---
local entity = spawner.Create({
    Entity = {
        Name = "Smiler",
        Asset = "https://raw.githubusercontent.com/no12356/Doors-Hardmode-Remake/main/models/smiler.rbxm",
        HeightOffset = 1
    },
    Lights = {
        Flicker = { Enabled = true, Duration = 5 },
        Shatter = true,
        Repair = false
    },
    Earthquake = { Enabled = true },
    CameraShake = { Enabled = true, Range = 100, Values = {20, 20, 1, 2} },
    Movement = { Speed = 850, Delay = 0, Reversed = false },
    Rebounding = { Enabled = true, Type = "Ambush", Min = 5, Max = 5, Delay = 0.3 },
    Damage = { Enabled = true, IgnoreHiding = false, Range = 100, Amount = 150 },
    Crucifixion = { Enabled = true, Range = 40, Resist = false, Break = true },
    Death = {
        Type = "Guiding",
        Hints = {"¡¡ THIS SMILE IS LIKE AMBUSH !!", "Hide and don't Smile", "Don't get Tricked"},
        Cause = "Smiler"
    }
})

---====== Debug Callbacks ======---
entity:SetCallback("OnSpawned", function()
    print("Smiler has spawned")
end)

entity:SetCallback("OnStartMoving", function()
    print("Smiler has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
    if firstTime == true then
        print("Smiler has entered room: ".. room.Name.. " for the first time")
    else
        print("Smiler has entered room: ".. room.Name.. " again")
    end
end)

entity:SetCallback("OnDespawned", function()
    print("Smiler despawned")
end)

---====== Synced Room Progression Loop ======---
local SpawnChance = 15
local MinRoom = 25
local lastRoomVal = latestRoom.Value

latestRoom.Changed:Connect(function(roomNum)
    if roomNum > lastRoomVal then
        lastRoomVal = roomNum
        math.randomseed(roomNum * 12345)
        
        if roomNum >= MinRoom then
            local roll = math.random(1, 100)
            if roll <= SpawnChance then
                pcall(function()
                    entity:Run()
                end)
            end
        end
    end
end)
