-- SURVIVE ACHIEVEMENT
--========================

local AchievementEarned = false

-- Debug callbacks

NightmareAmbush:SetCallback("OnSpawned", function()
    print("[Nightmare Ambush] Spawned")
end)

NightmareAmbush:SetCallback("OnStartMoving", function()
    print("[Nightmare Ambush] Started moving")
end)

NightmareAmbush:SetCallback("OnReachedNode", function()
    print("[Nightmare Ambush] Reached node")
end)

NightmareAmbush:SetCallback("OnEnterRoom", function(room)
    print("[Nightmare Ambush] Entered room:", room)
end)

NightmareAmbush:SetCallback("OnLookAt", function(isVisible)
    print("[Nightmare Ambush] Looked at:", isVisible)
end)

NightmareAmbush:SetCallback("OnRebounding", function()
    print("[Nightmare Ambush] Rebounding")
end)

NightmareAmbush:SetCallback("OnDespawning", function()
    print("[Nightmare Ambush] Despawning")
end)

NightmareAmbush:SetCallback("OnDespawned", function()

    print("[Nightmare Ambush] Despawned")

    if AchievementEarned then
        return
    end

    local character = game.Players.LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid and humanoid.Health > 0 then

        AchievementEarned = true

        local achievementGiver = loadstring(game:HttpGet(
            "https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
        ))()

        achievementGiver({
            Title = "Ambush But Even Harder",
            Desc = "Don't be fooled",
            Reason = "Encounter And Survive Nightmare Ambush",
            Image = "0"
        })

    end
end)

NightmareAmbush:SetCallback("OnDamagePlayer", function()
    print("[Nightmare Ambush] Damaged player")
end)

NightmareAmbush:SetCallback("CrucifixionOverwrite", function()
    print("[Nightmare Ambush] Crucifixion overwritten")
end)

NightmareAmbush:Run()