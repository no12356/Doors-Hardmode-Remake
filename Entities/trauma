---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
	print("Trauma has spawned")
end)

entity:SetCallback("OnStartMoving", function()
	print("Trauma has started moving")
end)

entity:SetCallback("OnReachNode", function(node)
	print("Trauma has reached node:", node)
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
	if firstTime == true then
		print("Trauma has entered room: ".. room.Name.. " for the first time")
	else
		print("Trauma has entered room: ".. room.Name.. " again")
	end
end)

entity:SetCallback("OnLookAt", function(lineOfSight)
	if lineOfSight == true then
		print("Player is looking at Trauma")
	else
		print("Player view is obstructed from Trauma")
	end
end)

entity:SetCallback("OnRebounding", function(startOfRebound)
	if startOfRebound == true then
		print("Trauma has started rebounding")
	else
		print("Trauma has finished rebounding")
	end
end)

entity:SetCallback("OnDespawning", function()
	print("Trauma is despawning")
end)

entity:SetCallback("OnDespawned", function()
	print("Trauma has despawned")
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
	if newHealth == 0 then
		print("Trauma has killed the player")
	else
		print("Trauma has damaged the player")
	end
end)

---====== Run entity ======---

entity:Run()

