---====== Load spawner ======---
local spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"))()

---====== Create entity template ======---
local entity = spawner.Create({
    Entity = {
        Name = "Baller",
        Asset = "11421844649", -- Replace with your uploaded model asset ID if needed
        HeightOffset = 0
    },
    Lights = {
        Flicker = { Enabled = true, Duration = 2 },
        Shatter = false,
        Repair = true
    },
    Earthquake = { Enabled = false },
    CameraShake = { Enabled = true, Range = 80, Values = {5, 15, 0.3, 1} },
    Movement = { Speed = 200, Delay = 5, Reversed = false },
    Rebounding = { Enabled = true, Type = "Blitz", Min = 12, Max = 12, Delay = 1 },
    Damage = { Enabled = false, IgnoreHiding = false, Range = 70, Amount = 100 },
    Crucifixion = { Enabled = true, Range = 40, Resist = false, Break = true },
    Death = {
        Type = "Curious",
        Hints = {"You died to Baller...", "Stop posting about Baller!", "how in the fuck did you die to baller"},
        Cause = "Baller"
    }
})

---====== Debug Callbacks ======---
entity:SetCallback("OnSpawned", function()
    print("Baller has spawned")
end)

entity:SetCallback("OnStartMoving", function()
    print("Baller has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
    if firstTime == true then
        print("Baller has entered room: ".. room.Name.. " for the first time")
    else
        print("Baller has entered room: ".. room.Name.. " again")
    end
end)

entity:SetCallback("OnDespawned", function()
    print("Baller despawned")
end)

---====== Run entity ======---
entity:Run()
