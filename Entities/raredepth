---====== Achievement ======---

local AchievementEarned = false

---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
	print("Depth has spawned")
end)

entity:SetCallback("OnStartMoving", function()
	print("Depth has started moving")
end)

entity:SetCallback("OnReachedNode", function(node)
	print("Depth has reached node:", node)
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
	if firstTime == true then
		print("Depth has entered room: ".. room.Name.. " for the first time")
	else
		print("Depth has entered room: ".. room.Name.. " again")
	end
end)

entity:SetCallback("OnLookAt", function(lineOfSight)
	if lineOfSight == true then
		print("Player is looking at Depth")
	else
		print("Player view is obstructed from Depth")
	end
end)

entity:SetCallback("OnRebounding", function(startOfRebound)
	if startOfRebound == true then
		print("Depth has started rebounding")
	else
		print("Depth has finished rebounding")
	end
end)

entity:SetCallback("OnDespawning", function()
	print("Depth is despawning")
end)

entity:SetCallback("OnDespawned", function()

	print("Depth has despawned")

entity:SetCallback("OnDamagePlayer", function(newHealth)
	if newHealth == 0 then
		print("Depth has killed the player")
	else
		print("Depth has damaged the player")
	end
end)

---====== Run entity ======---

entity:Run()

